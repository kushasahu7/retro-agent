#!/usr/bin/env bash
# Dev wrapper so `./retro <cmd>` works straight from a checkout, from any
# working directory, without installing. An installed copy gets a real `retro`
# entry point instead and does not use this file.
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec env PYTHONPATH="$DIR${PYTHONPATH:+:$PYTHONPATH}" \
     "${RETRO_PYTHON:-python3}" -m retro_agent.cli "$@"
